{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Checkflat",
  "version": "0.0.1",
  "identifier": "com.checkflat.app",
  "build": {
    "features": ["report-typst", "report-printpdf"],
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Checkflat",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "assetProtocol": { "enable": true, "scope": ["$APPDATA/projects/**", "$APPDATA/spike-tiles/**"] },
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; img-src 'self' data: blob: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost blob: data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
